# Copie para `.env` para ajustar qualquer valor (o `.env` não vai para o git nem para a imagem).
# Tudo é opcional: os valores abaixo são os padrões e já funcionam com `docker compose up`.
#
# No Compose, DATABASE_URL, SQS_ENDPOINT e PORT são fixados pelo próprio docker-compose.yml
# (apontam para os serviços `postgres` e `localstack` da rede do Compose). Os valores desses
# três aqui valem só para rodar a aplicação direto na máquina (`bun run start`).

# ---------------------------------------------------------------- Aplicação
# Porta HTTP dentro do processo (no Compose é sempre 3000).
PORT=3000
# Papéis do processo, separados por vírgula: api, consumer, outbox, pending-worker.
# Padrão: todos. Dá para separar em instâncias especializadas.
APP_ROLES=api,consumer,outbox,pending-worker
# Só Compose: portas do host para as instâncias do `app`. Um intervalo permite `--scale app=3`
# (cada instância ganha a próxima porta livre do intervalo).
APP_PORTS=3000-3009

# ---------------------------------------------------------------- Banco (PostgreSQL)
POSTGRES_USER=wagering
POSTGRES_PASSWORD=wagering
POSTGRES_DB=wagering
# Só Compose: porta do Postgres exposta no host. Troque (ex.: 5433) se a 5432 já estiver ocupada.
POSTGRES_PORT=5432
# Só fora do Compose (aplicação e CLI de migrations rodando na máquina).
DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering
# Tempo máximo esperando um lock de linha (ms). Estourou: 503 LOCK_TIMEOUT com Retry-After.
DB_LOCK_TIMEOUT_MS=5000

# ---------------------------------------------------------------- Fila (SQS via LocalStack)
# Só Compose: porta do LocalStack exposta no host.
LOCALSTACK_PORT=4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Só fora do Compose.
SQS_ENDPOINT=http://localhost:4566
SQS_TRANSACTIONS_QUEUE=wager-transactions.fifo
SQS_TRANSACTIONS_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wager-events.fifo

# ---------------------------------------------------------------- Workers
# Consumidor da fila de entrada (papel `consumer`)
CONSUMER_WAIT_SECONDS=20
CONSUMER_BATCH_SIZE=10
CONSUMER_CONCURRENCY=5
CONSUMER_VISIBILITY_TIMEOUT_SECONDS=30
CONSUMER_BACKOFF_BASE_SECONDS=1
CONSUMER_BACKOFF_MAX_SECONDS=60
CONSUMER_SDK_TIMEOUT_MS=5000
CONSUMER_SHUTDOWN_TIMEOUT_MS=30000
# Intervalo de leitura do tamanho da DLQ (gauge wager_dlq_messages).
DLQ_MONITOR_INTERVAL_MS=30000

# Publicador da outbox (papel `outbox`)
OUTBOX_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=10
OUTBOX_SEND_TIMEOUT_MS=3000
OUTBOX_ALERT_ATTEMPTS=10

# Worker de transações PENDING_REFERENCE (papel `pending-worker`)
PENDING_REFERENCE_MAX_ATTEMPTS=10
PENDING_REFERENCE_TTL_MS=900000
PENDING_WORKER_INTERVAL_MS=1000
PENDING_WORKER_BATCH_SIZE=20

# ---------------------------------------------------------------- Observabilidade
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Métricas padrão do processo (CPU, memória, event loop) além das métricas wager_*.
METRICS_DEFAULT_METRICS=true

# ---------------------------------------------------------------- Falhas de teste (NUNCA em produção)
# Faz o processo morrer (SIGKILL de si mesmo) ao chegar no ponto indicado. Só existe para os
# testes de crash (`bun run test:concurrency`). FAULT_POINT sem ENABLE_FAULT_INJECTION=true
# derruba a subida da aplicação.
# Pontos: consumer.after_commit_before_ack | outbox.after_send_before_mark
# ENABLE_FAULT_INJECTION=true
# FAULT_POINT=consumer.after_commit_before_ack

# ---------------------------------------------------------------- Infra dos testes (docker-compose.test.yml)
# Portas do host usadas por `bun run infra:test:up` e pelos testes.
# TEST_POSTGRES_PORT=55432
# TEST_LOCALSTACK_PORT=45660
