{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "description": "Jungle Gaming technical challenge: distributed wagering processor",
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch run src/main.ts",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "migration:create": "bunx --bun mikro-orm migration:create",
    "migration:up": "bunx --bun mikro-orm migration:up",
    "migration:down": "bunx --bun mikro-orm migration:down",
    "migration:list": "bunx --bun mikro-orm migration:list",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down -v",
    "infra:queues": "docker compose exec localstack awslocal sqs list-queues",
    "infra:test:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "infra:test:down": "docker compose -f docker-compose.test.yml down -v"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1156.0",
    "@mikro-orm/core": "^7.2.5",
    "@mikro-orm/migrations": "^7.2.5",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.5",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@mikro-orm/cli": "^7.2.5",
    "@nestjs/testing": "^12.2.0",
    "@types/bun": "^1.4.4",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "typescript": "~5.9.3"
  }
}
