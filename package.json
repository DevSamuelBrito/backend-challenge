{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "description": "Jungle Gaming technical challenge: distributed wagering processor",
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch run src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down -v",
    "infra:queues": "docker compose exec localstack awslocal sqs list-queues"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/bun": "^1.4.4",
    "typescript": "~5.9.3"
  }
}
